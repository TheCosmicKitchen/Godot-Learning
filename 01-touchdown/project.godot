; Engine configuration file.
; Most of this is easier to change in the editor: Project → Project Settings.

config_version=5

[application]

config/name="Touchdown"
config/description="Land the ship from inside it. Two crew, one per hand, one at each thruster lever, at opposite ends of the cabin."
run/main_scene="res://title/Title.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Touchdown"

[input]

p1_move_left={
"deadzone": 0.35,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0), Object(InputEventJoypadButton,"device":-1,"button_index":13)]
}
p1_move_right={
"deadzone": 0.35,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0), Object(InputEventJoypadButton,"device":-1,"button_index":14)]
}
p1_jump={
"deadzone": 0.35,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":9), Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)]
}
p1_lever_up={
"deadzone": 0.35,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0), Object(InputEventJoypadButton,"device":-1,"button_index":11)]
}
p1_lever_down={
"deadzone": 0.35,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0), Object(InputEventJoypadButton,"device":-1,"button_index":12)]
}
p2_move_left={
"deadzone": 0.35,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194319), Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0), Object(InputEventJoypadButton,"device":-1,"button_index":2)]
}
p2_move_right={
"deadzone": 0.35,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194321), Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0), Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}
p2_jump={
"deadzone": 0.35,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194309), Object(InputEventKey,"device":-1,"physical_keycode":4194310), Object(InputEventJoypadButton,"device":-1,"button_index":10), Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]
}
p2_lever_up={
"deadzone": 0.35,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194320), Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0), Object(InputEventJoypadButton,"device":-1,"button_index":3)]
